// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums represented as strings for SQLite & universal database portability

model User {
  id                      String    @id @default(cuid())
  name                    String
  firstName               String?
  lastName                String?
  email                   String    @unique
  passwordHash            String
  role                    String    @default("USER") // USER, ADMIN
  status                  String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SUSPENDED
  phone                   String?
  address                 String?
  address2                String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String?   @default("India")
  isVerified              Boolean   @default(true)
  registeredAt            DateTime  @default(now())
  approvedAt              DateTime?
  approvedBy              String?
  rejectedAt              DateTime?
  rejectionReason         String?
  suspendedAt             DateTime?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  passwordResetUsedAt     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  orders                  Order[]
  entitlements            DownloadEntitlement[]
  downloadLogs            DownloadLog[]
  wishlists               Wishlist[]
  tickets                 SupportTicket[]
  notifications           Notification[]
  auditLogs               AuditLog[]
}

model CaptchaChallenge {
  id        String   @id @default(cuid())
  token     String   @unique
  answer    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  sku           String    @unique
  shortDesc     String?
  description   String
  fullSpecs     String?   // JSON or Markdown
  regularPrice  Float
  salePrice     Float?
  isFree        Boolean   @default(false)
  categoryId    String
  compatibility String    @default("Open Rails / MSTS") // Open Rails, MSTS, Both
  version       String    @default("v1.0")
  fileSize      String?   // e.g. "124 MB"
  status        String    @default("AVAILABLE") // AVAILABLE, COMING_SOON, ARCHIVED
  isFeatured    Boolean   @default(false)
  isNewArrival  Boolean   @default(false)
  installGuide  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category      ProductCategory @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  files         ProductFile[]
  versions      ProductVersion[]
  orderItems    OrderItem[]
  entitlements  DownloadEntitlement[]
  wishlists     Wishlist[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFile {
  id            String   @id @default(cuid())
  productId     String
  name          String
  fileName      String
  fileFormat    String   @default("ZIP") // ZIP, RAR, 7Z, EXE, PDF
  fileSize      String
  version       String   @default("v1.0")
  storagePath   String   // Internal path or secure cloud URL
  isPublicFree  Boolean  @default(false)
  downloadLimit Int      @default(10)
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  entitlements  DownloadEntitlement[]
  downloadLogs  DownloadLog[]
}

model ProductVersion {
  id            String   @id @default(cuid())
  productId     String
  versionNumber String
  changeLog     String?
  releaseDate   DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Project {
  id            String   @id @default(cuid())
  projectNo     String   // e.g. "01", "02"
  title         String
  slug          String   @unique
  subtitle      String?
  description   String
  fullContent   String?
  mainImage     String
  status        String   @default("COMPLETED") // COMPLETED, WORK_IN_PROGRESS, PLANNED
  compatibility String   @default("Open Rails 1.4+, MSTS Bin 1.8")
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images        ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(cuid())
  serviceNo   String   // e.g. "01", "02"
  title       String
  slug        String   @unique
  description String
  fullDetails String
  icon        String?  // lucide icon name
  image       String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  customerName   String
  customerEmail  String
  customerPhone  String?
  billingAddress String?
  city           String?
  state          String?
  country        String?     @default("India")
  pincode        String?
  totalAmount    Float
  discountAmount Float       @default(0)
  finalAmount    Float
  status         String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED, CANCELLED
  paymentMethod  String      @default("RAZORPAY") // RAZORPAY, STRIPE, SIMULATOR
  paymentId      String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User?       @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  entitlements   DownloadEntitlement[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int      @default(1)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String
  gateway       String   // RAZORPAY, STRIPE, SIMULATOR
  transactionId String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  rawResponse   String?  // JSON string
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DownloadEntitlement {
  id            String       @id @default(cuid())
  userId        String
  productId     String
  productFileId String
  orderId       String?
  maxDownloads  Int          @default(10)
  downloadCount Int          @default(0)
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile   ProductFile  @relation(fields: [productFileId], references: [id], onDelete: Cascade)
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  downloadLogs  DownloadLog[]
}

model DownloadLog {
  id            String              @id @default(cuid())
  entitlementId String?
  userId        String?
  fileId        String
  ipAddress     String?
  userAgent     String?
  downloadedAt  DateTime            @default(now())

  entitlement   DownloadEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  file          ProductFile         @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  discountPercent Float?    // e.g. 10 for 10%
  discountAmount  Float?    // e.g. 100 for Rs.100 off
  minPurchase     Float     @default(0)
  maxDiscount     Float?
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  usageLimit      Int?
  timesUsed       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model ContactEnquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  enquiryType String   @default("GENERAL") // GENERAL, CUSTOM_MODEL, SUPPORT, COMMERCIAL
  status      String   @default("NEW")     // NEW, IN_PROGRESS, RESOLVED, CLOSED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNo    String   @unique
  userId      String
  subject     String
  category    String   @default("TECHNICAL") // TECHNICAL, BILLING, DOWNLOAD, LICENSE
  priority    String   @default("NORMAL")    // LOW, NORMAL, HIGH, URGENT
  status      String   @default("OPEN")      // OPEN, ANSWERED, RESOLVED, CLOSED
  message     String
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebsiteSetting {
  id             String   @id @default("default")
  siteName       String   @default("VG-3D Modelers & Railway Simulations")
  tagline        String   @default("High-Precision 3D Models & Rolling Stock for Open Rails and MSTS")
  founderName    String   @default("Varun Ganesh")
  contactEmail   String   @default("support@vg3dmodelersandrailwaysimulations.com")
  contactPhone   String   @default("+91 98765 43210")
  whatsappNumber String   @default("+919876543210")
  currencySymbol String   @default("₹")
  currencyCode   String   @default("INR")
  heroTitle      String   @default("Crafting The Future of Indian Railway Simulations")
  heroSubtitle   String   @default("Hyper-realistic LHB coaches, Vistadome, locos, and route assets built with engineering precision for Open Rails & MSTS.")
  disclaimerText String   @default("VG-3D Modelers & Railway Simulations is an independent digital creator platform. All models are crafted for train simulation enthusiasts. Indian Railways is a trademark of the Government of India; all representations are artistic recreation for simulation purposes.")
  termsContent   String?
  privacyContent String?
  eulaContent    String?
  refundContent  String?
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model Trainboard {
  id          String   @id @default(cuid())
  name        String
  zone        String   // WR, CR, ECoR, etc.
  zoneName    String
  size        String   @default("2.5 MB")
  downloadUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
